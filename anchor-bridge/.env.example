# KenLens anchor bridge settings — read by docker-compose.yml in this directory.
# anchor-bridge-setup.sh creates `.env` from this file.

# The release to run. The release pipeline pins it; upgrade with ./anchor-bridge-setup.sh --update.
KENLENS_VERSION=v0.1.621

# The group that owns the serial device nodes on this host, as a number (`stat -Lc %g /dev/serial0`
# or of a /dev/serial/by-id/ link). anchor-bridge-setup.sh fills it in; 20 is dialout on
# Raspberry Pi OS and Debian.
SERIAL_BRIDGE_GID=

# The port the manager UI is reached on. The anchors' consoles are always 8441-8456.
ANCHOR_BRIDGE_MANAGER_PORT=8440

# Where the image is pulled from. Leave unset unless you mirror it.
# KENLENS_IMAGE_REPO=ghcr.io/kenlens-rtls
