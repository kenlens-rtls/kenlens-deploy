# KenLens production settings — read by docker-compose.yml in this directory.
# kenlens-setup.sh creates `.env` from this file. Secrets do not belong here; they live in
# config/secrets/.

# The release to run. Pin an exact version; upgrading is changing this line, then
# `docker compose pull && docker compose up -d`.
KENLENS_VERSION=v0.1.1208

# The port browsers connect to. Inside the container the server always listens on 8443; this is
# only the host side of the mapping. Change it, then `docker compose up -d`.
KENLENS_HTTPS_PORT=8443

# The planar fallback. Unset, tags are solved in three dimensions, which needs anchors mounted
# at least 1 m above the highest tagged object (see the wiki's Anchor installation page). Set,
# every tag is held at this height, in metres, in the same frame as the anchor survey: for a
# site that cannot mount its anchors that high. kenlens-setup.sh --tag-height sets it; to set it
# by hand, uncomment the line, then `docker compose up -d`. Remove it to go back to 3D.
# KENLENS_TAG_HEIGHT_METRES=1.2

# The host names and/or IPs the web and broker certificates were issued for, comma-separated.
# Written by kenlens-setup.sh as a record; editing it re-issues nothing. To change the names,
# run `./kenlens-setup.sh --host <name> ... --rotate web --rotate broker`.
# KENLENS_HOST=kenlens.example.lan,192.168.1.20

# The site DNS domains anchor console certificates may name besides <host>.local, comma-separated.
# The anchor console CA is constrained to exactly these. Written by kenlens-setup.sh as a record;
# editing it re-issues nothing. To change them, run
# `./kenlens-setup.sh --rotate anchor-ca --domain <domain> ...`.
# KENLENS_ANCHOR_DOMAINS=example.lan

# The memory PostgreSQL is tuned for, read once when the database is first created.
# kenlens-setup.sh sets it to this host's RAM; changing it later changes nothing.
# KENLENS_DB_TUNE_MEMORY=4096MB

# Where scheduled backups are written (Story 6.7): a path on this machine starting with ./ (relative to this
# directory) or / (absolute); a bare name would be read as a Docker volume. Another disk or a mounted
# network share is better than ./backups on the disk they protect.
# Changed here, it takes effect with `docker compose up -d`.
# KENLENS_BACKUP_DIR=./backups

# Accept anonymous, UNENCRYPTED MQTT on port 1883 as well as TLS + password on 8883.
# Insecure: anyone on the network can publish anchor data. Needed only while anchor
# firmware cannot connect over TLS. This is only the starting value: after the first start
# the switch is on KenLens's MQTT settings page, and editing this line changes nothing.
MQTT_ANONYMOUS_LISTENER=false

# Where the server image is pulled from. Leave unset unless you mirror it.
# KENLENS_IMAGE_REPO=ghcr.io/kenlens-rtls
