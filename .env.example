# KenLens production settings — read by docker-compose.yml in this directory.
# kenlens-setup.sh creates `.env` from this file. Secrets do not belong here; they live in
# config/secrets/.

# The release to run. Pin an exact version; upgrading is changing this line, then
# `docker compose pull && docker compose up -d`.
KENLENS_VERSION=v0.1.47

# REQUIRED — the height tags are carried at, in metres, in the same frame as the anchor
# survey (docs/TDOA-COMMISSIONING.md). There is no default on purpose: positions are
# solved with the tag held at this height, so a guess makes every position wrong without
# any error. Measure it, then uncomment.
# KENLENS_TAG_HEIGHT_METRES=1.2

# The host names and/or IPs the web and broker certificates were issued for, comma-separated.
# Written by kenlens-setup.sh as a record; editing it re-issues nothing. To change the names,
# run `./kenlens-setup.sh --host <name> ... --rotate web --rotate broker`.
# KENLENS_HOST=kenlens.example.lan,192.168.1.20

# Serve anonymous, UNENCRYPTED MQTT on port 1883 as well as TLS + password on 8883.
# Insecure: anyone on the network can publish and subscribe. Needed only while anchor
# firmware cannot connect over TLS; leave it false otherwise. Apply a change with
# `docker compose up -d`.
MQTT_ANONYMOUS_LISTENER=false

# Where the server image is pulled from. Leave unset unless you mirror it.
# KENLENS_IMAGE_REPO=ghcr.io/kenlens-rtls
